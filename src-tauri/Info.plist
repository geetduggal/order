<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Calendar (EventKit) access. Required or the permission prompt crashes;
	     shown to the user when Order first requests calendar access. Merged into
	     both the macOS and iOS bundle Info.plist by Tauri. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Order reads events from your selected calendars to import your day, and creates events you assign to a calendar. Invitations are sent through Google, not Apple.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Order reads events from your selected calendars to import your day, and creates events you assign to a calendar.</string>
	<!-- Voice chat with the in-app agent. Microphone captures what you say;
	     speech recognition is used only when you pick the on-device (Apple)
	     transcription engine — the default (Whisper) sends audio to OpenAI. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Order uses the microphone so you can talk to the in-app agent by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Order transcribes your voice on this device when you choose Apple's on-device speech recognition for the agent.</string>
	<!-- Keep read-aloud (TTS) audio playing when Order is backgrounded / the
	     phone is locked. iOS-only; ignored on macOS. Paired with an active
	     AVAudioSession(.playback) set before speaking (see src/tts.rs). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
